# DTCG Database Updater 配置文件示例
# 复制此文件为 .env 并填写实际值

# ============================================
# 爬虫配置
# ============================================

## 日文官网基础 URL
BASE_URL=https://digimoncard.com

## 输出目录
OUTPUT_DIR=../skill/data

# ============================================
# 代理配置（可选）
# ============================================

## HTTP 代理
# HTTP_PROXY=http://proxy.example.com:8080

## HTTPS 代理
# HTTPS_PROXY=http://proxy.example.com:8080

# ============================================
# 爬虫参数（可选）
# ============================================

## 请求延迟（秒）
# REQUEST_DELAY=2

## 重试次数
# MAX_RETRIES=3

## 超时时间（秒）
# TIMEOUT=30
