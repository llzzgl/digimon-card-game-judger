# DTCG Judger 配置文件示例
# 复制此文件为 .env 并填写实际值
# 注意：.env 文件包含敏感信息，请勿提交到 Git

# ============================================
# LLM API 配置（二选一）
# ============================================

## 选项 1: 使用通义千问 API（推荐，稳定）
LLM_MODEL=qwen
DASHSCOPE_API_KEY=your_dashscope_api_key_here

## 选项 2: 使用微调模型（需要本地模型）
# LLM_MODEL=finetuned
# FINETUNED_BASE_MODEL=Qwen/Qwen2-1.5B-Instruct
# FINETUNED_LORA_PATH=finetune/output/dtcg_qwen_lora

# ============================================
# 图片识别配置（可选）
# ============================================

## Google Gemini API（用于图片识别）
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# 数据库配置（可选）
# ============================================

## SQLite 数据库路径
# DATABASE_PATH=card_data/card_metadata.db

# ============================================
# 服务器配置（可选）
# ============================================

## API 服务端口
# API_PORT=8000

## API 服务主机
# API_HOST=0.0.0.0
